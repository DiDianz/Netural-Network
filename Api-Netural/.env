# 数据库类型: mysql 或 mssql
DB_TYPE=mssql

# MySQL 配置
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=neural_predict
MYSQL_USERNAME=root
MYSQL_PASSWORD=Aa123456
MYSQL_CHARSET=utf8mb4

# SQL Server 配置 (DB_TYPE=mssql 时生效)
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=neural_predict
MSSQL_USERNAME=sa
MSSQL_PASSWORD=Aa123456
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# JWT 配置
JWT_SECRET_KEY=your-super-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 应用配置
APP_DEBUG=true
APP_TITLE=神经网络预测系统
